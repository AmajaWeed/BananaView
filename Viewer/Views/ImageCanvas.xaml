<UserControl x:Class="Viewer.Views.ImageCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             ClipToBounds="True" Background="Transparent"
             Focusable="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- Canvas, not Grid: a Grid child that's explicitly sized LARGER than its
         container (any zoom past "fit") and centered via HorizontalAlignment/
         VerticalAlignment hit a confirmed WPF layout bug that cropped it
         instead of just overflowing - reproduced even via RenderTargetBitmap,
         so it's not a DWM/compositor thing. A Canvas doesn't do alignment-
         based arrange at all: children are drawn at whatever Canvas.Left/Top
         we compute ourselves (see ImageCanvas.xaml.cs), which sidesteps that
         code path entirely. -->
    <Canvas x:Name="RootGrid">
        <!-- Stretch="Fill" onto an explicitly-set Width/Height (set in code to
             the bitmap's raw PixelWidth/PixelHeight, times the current zoom)
             instead of "None" + relying on WPF's own DPI-derived natural size:
             a photo viewer should map pixels 1:1 by our own scale factor, not
             defer to a file's (often bogus) embedded DPI metadata. -->
        <Image x:Name="OutgoingImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="Linear"
               IsHitTestVisible="False"
               RenderTransformOrigin="0.5,0.5"
               Opacity="0"/>

        <Image x:Name="MainImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="Linear"
               RenderTransformOrigin="0.5,0.5"
               Opacity="0">
            <!-- RenderTransform only ever rotates/pans here - both cheap,
                 GPU-composited operations. The base position (centering) and
                 zoom size are handled directly via Canvas.Left/Top and
                 Width/Height in code, never through layout-based centering of
                 an oversized element (see the Canvas comment above). -->
            <Image.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="RotateT" Angle="0"/>
                    <TranslateTransform x:Name="TranslateT" X="0" Y="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Canvas>
</UserControl>
