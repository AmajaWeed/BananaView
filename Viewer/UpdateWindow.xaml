<Window x:Class="Viewer.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Доступно обновление" Height="240" Width="380"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" Foreground="White">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="#FF1C1C1C" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Доступна новая версия BananaView" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionsText" Grid.Row="1" FontSize="12" Foreground="#AAAAAA" Margin="0,6,0,0"/>

            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <ProgressBar x:Name="ProgressIndicator" IsIndeterminate="True" Height="4" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="PostponeButton" Content="Отложить" Click="Postpone_Click" Padding="12,6" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"/>
                <Button x:Name="SkipButton" Content="Пропустить версию" Click="Skip_Click" Padding="12,6" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"/>
                <Button x:Name="UpdateButton" Content="Обновить" Click="Update_Click" Padding="14,6"
                        Background="#2A6FDB" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
