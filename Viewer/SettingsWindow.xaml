<Window x:Class="Viewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Настройки" Height="360" Width="380"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" Foreground="White">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="#FF1C1C1C" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Настройки BananaView" FontSize="16" FontWeight="Bold"/>
                <Button Content="&#xE8BB;" Click="Close_Click" Style="{StaticResource ToolbarButton}"
                        HorizontalAlignment="Right" Width="24" Height="24"/>
            </Grid>

            <!-- Thumbnails -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="МИНИАТЮРЫ" FontSize="10" Foreground="#888888" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Размер миниатюры" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ThumbnailSizeLabel" Grid.Column="1" VerticalAlignment="Center" Foreground="#AAAAAA"/>
                </Grid>
                <Slider x:Name="ThumbnailSizeSlider" Minimum="50" Maximum="300" TickFrequency="10"
                        IsSnapToTickEnabled="True" Margin="0,4,0,10"
                        ValueChanged="ThumbnailSizeSlider_ValueChanged"/>

                <Button x:Name="ClearCacheButton" Content="Очистить кэш миниатюр" Click="ClearCache_Click"
                        HorizontalAlignment="Left" Padding="12,6" Background="#2A2A2A" Foreground="White" BorderThickness="0"/>
                <TextBlock x:Name="CacheStatusText" FontSize="11" Foreground="#888888" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- About / update -->
            <StackPanel Grid.Row="2" Margin="0,24,0,0">
                <TextBlock Text="О ПРОГРАММЕ" FontSize="10" Foreground="#888888" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="BananaView" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center" Foreground="#AAAAAA"/>
                </Grid>
                <StackPanel x:Name="UpdateStatusPanel" Margin="0,8,0,0">
                    <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Click="CheckUpdate_Click"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6"
                        Background="#2A2A2A" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
