<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-SDK-versioned TFM (not just "net8.0-windows") is what unlocks
         direct use of Windows Runtime APIs like Windows.Media.Ocr from a
         normal WPF app - no separate WinRT interop package needed. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.Clipboard.SetImage: WPF's own
         Clipboard.SetImage writes a malformed DIB for pasting into non-WPF
         apps (browsers included) - images come out skewed/garbled. WinForms'
         GDI+-backed clipboard writer doesn't have that bug. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BananaView</AssemblyName>
    <AssemblyTitle>BananaView</AssemblyTitle>
    <Product>BananaView</Product>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.16.0" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
    <!-- .clip files embed their preview PNG inside an attached SQLite
         database chunk (see ClipImageLoader) - this is the lightweight
         official Microsoft SQLite provider, used here purely to run one
         SELECT against a temp-extracted db file. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!-- UseWindowsForms implicitly global-usings System.Windows.Forms and
       System.Drawing, which collide with WPF's own System.Windows types
       (Application, Point, Brush, ...) throughout the codebase - drop them
       and require explicit System.Windows.Forms./System.Drawing. qualification
       at the few call sites that actually need those namespaces. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

</Project>
