<Window x:Class="Viewer.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Переименовать" Height="150" Width="380"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" Foreground="White">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="#FF1C1C1C" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Новое имя файла" FontSize="14" FontWeight="Bold"/>

            <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,12,0,0" Padding="6,5" FontSize="13"
                     Background="#2A2A2A" Foreground="White" BorderThickness="0"
                     KeyDown="NameBox_KeyDown"/>

            <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FF7A7A" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Отмена" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"/>
                <Button Content="Переименовать" Click="Ok_Click" Padding="14,6"
                        Background="#2A6FDB" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
